{
  "manifest_version": 3,
  "name": "Clean from AI",
  "version": "2.3.0",
  "homepage_url": "https://handsher.github.io/clean-from-ai/",
  "description": "Strips hidden AI watermark characters and AI typography from your posts on X and Typefully, or from any text you paste.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clean from AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://typefully.com/*"
      ],
      "js": [
        "clean.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ]
}
