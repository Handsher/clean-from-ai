{
  "manifest_version": 3,
  "name": "Clean from AI",
  "version": "3.2.0",
  "default_locale": "en",
  "homepage_url": "https://handsher.github.io/clean-from-ai/",
  "description": "__MSG_ext_description__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_action_title__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://typefully.com/*"
      ],
      "js": [
        "clean.js",
        "i18n.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ]
}
